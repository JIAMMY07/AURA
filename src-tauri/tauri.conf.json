{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI Assistant",
  "version": "0.1.0",
  "identifier": "local.aura.assistant",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": { "capabilities": ["main-capability"] },
    "windows": [{"label":"main","title":"AURA — Local AI Assistant","width":1180,"height":760,"minWidth":900,"minHeight":620}]
  },
  "plugins": {
    "sql": { "preload": ["sqlite:aura.db"] }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
