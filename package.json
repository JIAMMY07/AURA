{
  "name": "local-ai-assistant",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm sync:vision-runtime",
    "build": "tsc --noEmit && vite build",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "build:windows:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Debug",
    "sign:windows:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-windows-artifacts.ps1 -CreateLocalCertificate",
    "verify:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-distribution.ps1",
    "test": "vitest run && node --test integrations/alexa/*.node-test.mjs",
    "test:e2e": "playwright test",
    "test:evolution": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-evolution-promotion.ps1",
    "test:evolution:isolation": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-evolution-isolation.ps1",
    "test:all": "pnpm test && pnpm test:evolution && pnpm build && pnpm test:e2e",
    "test:all:host": "pnpm test:all && pnpm test:evolution:isolation",
    "sync:vision-runtime": "node scripts/sync-vision-runtime.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@tauri-apps/api": "^2.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
